      "category": "transportation",
      "timeTag": "later",
      "deadline": false,
      "title_en": "Bicycle anti-theft registration",
      "title_jp": "自転車防犯登録",
      "summary": "Legally required when you own a bike (~600 yen). Done at the bike shop where you buy it.",
      "bring": ["ID", "Proof of purchase (if registering a used/gifted bike)"],
      "gotcha": "Almost no foreigner knows this is mandatory — but police spot-checks ask for it.",
      "regionScoped": false,
      "byRegion": {}
