  "tips": [
    {
      "id": "tip-001",
      "scope": "item",
      "itemId": "moving-in-notice",
      "region": "shibuya",
      "tags": ["government", "timing"],
      "body": "Go in the morning. The residents counter gets packed right after lunch.",
      "author": "Mina K.",
      "date": "2026-05-20"
    },
    {
      "id": "tip-002",
      "scope": "item",
      "itemId": "health-insurance",
      "region": null,
      "tags": ["insurance", "money"],
      "body": "Your premium is based on last year's Japan income, so the first year is often cheap as a new arrival.",
      "author": "Theo",
      "date": "2026-05-19"
    },
    {
      "id": "tip-003",
      "scope": "global",
      "itemId": null,
      "region": null,
      "tags": ["money", "furniture"],
      "body": "Check Mercari and recycle shops before buying furniture new — rentals come with nothing, not even curtains or lights.",
      "author": "Dan",
      "date": "2026-05-18"
    },
    {
      "id": "tip-004",
      "scope": "global",
      "itemId": null,
      "region": null,
      "tags": ["banking", "money"],
      "body": "Open a Japan Post (ゆうちょ) account first — they accept new residents without 6 months of residency history. Most city banks will turn you away early on.",
      "author": "Alex",
      "date": "2026-05-15"
    },
    {
      "id": "tip-005",
      "scope": "global",
      "itemId": null,
      "region": null,
      "tags": ["housing"],
      "body": "Photograph every scratch and scuff in your apartment on move-in day and email them to your landlord that same day. Saves arguments when you move out.",
      "author": "Yuki T.",
      "date": "2026-05-10"
    },
    {
      "id": "tip-006",
      "scope": "global",
      "itemId": null,
      "region": null,
      "tags": ["daily-life", "money"],
      "body": "Convenience stores (7-Eleven, FamilyMart, Lawson) can pay most bills — utilities, NHK, even some city taxes. No need to queue at the ward office for those.",
      "author": "Sam",
      "date": "2026-05-05"
    }
  ]
}
