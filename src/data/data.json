  "items": [
    {
      "id": "coe-visa",
      "stage": "predeparture",
      "category": "status",
      "timeTag": "predeparture",
      "deadline": false,
      "title_en": "Certificate of Eligibility & visa",
      "title_jp": "在留資格認定証明書・査証",
      "summary": "Your sponsor (school/employer) gets the CoE; you turn it into a visa at a Japanese embassy back home.",
      "bring": ["Passport", "CoE (paper or e-CoE)", "Visa application form", "ID photos"],
      "gotcha": "The residence card itself is issued at the airport on arrival, not before. Don't wait for it abroad.",
      "regionScoped": false,
      "byRegion": {}
    },
    {
      "id": "medication-clearance",
      "stage": "predeparture",
      "category": "health",
      "timeTag": "predeparture",
      "deadline": false,
      "title_en": "Medication clearance",
      "title_jp": "輸入確認書（旧 薬監証明）",
      "summary": "Bringing more than ~1 month of prescription meds, syringes, or a CPAP needs an import certificate applied for before you fly.",
      "bring": ["Prescription (English OK)", "Doctor's letter", "Import certificate if over the limit"],
      "gotcha": "Some meds (e.g. Adderall) and any THC/CBD-oil are banned outright — even with paperwork. Check before you pack.",
      "regionScoped": false,
      "byRegion": {}
    },
    {
      "id": "moving-in-notice",
      "stage": "first2weeks",
      "category": "government",
      "timeTag": "within14days",
      "deadline": true,
      "title_en": "Moving-in notification",
      "title_jp": "転入届",
      "summary": "Register your new address. This creates your resident record and unlocks almost everything else.",
      "bring": ["Residence card", "Passport", "Moving-out certificate (if from another Japanese city)"],
      "gotcha": "Miss it past 90 days without a valid reason and your residence status can be voided.",
      "regionScoped": true,
      "byRegion": {
        "shibuya": {
          "office": "Shibuya Ward Office — Residents Division",
          "note": "Foreign-resident counter available; bring everything in one trip."
        },
        "hachioji": {
          "office": "Hachioji City Hall — Residents Section",
          "note": "Multilingual support desk on site."
        }
      }
    },
    {
      "id": "health-insurance",
      "stage": "first2weeks",
      "category": "insurance",
      "timeTag": "within14days",
      "deadline": true,
      "title_en": "National Health Insurance",
      "title_jp": "国民健康保険",
      "summary": "If you're not on employer/school insurance, enroll at the city office (usually same visit as moving-in).",
      "bring": ["Residence card", "My Number (if issued)"],
      "gotcha": "Since Dec 2024 there's no paper insurance card — your My Number Card acts as it, or you get a 資格確認書 instead.",
      "regionScoped": true,
      "byRegion": {
        "shibuya": { "office": "Shibuya Ward Office — Insurance & Pension Division", "note": "" },
        "hachioji": { "office": "Hachioji City Hall — Insurance & Pension Section", "note": "" }
      }
    },
    {
      "id": "garbage-rules",
      "stage": "first2weeks",
      "category": "garbage",
      "timeTag": "week1",
      "deadline": false,
      "title_en": "Garbage sorting & collection days",
      "title_jp": "ゴミ分別・収集日",
      "summary": "Rules and pickup days differ by ward/city. Get them right before your first collection day.",
      "bring": [],
      "gotcha": "Wrong sorting = your bag gets left behind with a sticker, and neighbors notice.",
      "regionScoped": true,
      "byRegion": {
        "shibuya": { "office": "Check the Shibuya ward sorting guide for your block.", "note": "Burnable / non-burnable / recyclable on fixed weekdays." },
        "hachioji": { "office": "Hachioji uses designated paid garbage bags — buy at supermarkets/convenience stores.", "note": "Confirm your district's schedule." }
      }
    },
    {
      "id": "bicycle-registration",
